<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#171C1F">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }} &ndash; Used OEM Auto Parts in Amite, Louisiana</title>
    <meta name="description" content="A&B Motors Auto Recycling — used OEM auto parts from our ten-acre lot in Amite, Louisiana. Call 985-748-7195.">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% style %}
      body { background: var(--graphite); color: var(--chrome-3); }
      .pw { min-height: 100vh; display: grid; place-items: center; padding: 40px 20px; }
      .pw__card { width: min(560px, 100%); text-align: center; }
      .pw__logo { max-height: 84px; width: auto; margin: 0 auto 26px; }
      .pw__panel {
        margin-top: 26px; padding: 22px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: var(--radius-lg);
      }
      .pw a { color: var(--green); }
    {% endstyle %}
  </head>
  <body>
    <div class="pw">
      <div class="pw__card">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 800 | image_tag: class: 'pw__logo', alt: shop.name, loading: 'eager' }}
        {%- else -%}
          <div class="header__logo-text" style="font-size:34px;color:#fff;margin-bottom:20px;">
            <span class="chrome-text">A&amp;B</span> MOTORS
          </div>
        {%- endif -%}

        {{ content_for_layout }}

        <p class="small muted" style="margin-top:28px;">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; Amite, Louisiana
        </p>
      </div>
    </div>
  </body>
</html>
