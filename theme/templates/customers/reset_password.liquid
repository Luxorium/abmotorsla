<div class="page-width page-width--narrow">
  <div class="section">
    <h1 class="h1">Reset your password</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>New password</span><input type="password" name="customer[password]" required></label>
      <label class="field"><span>Confirm password</span><input type="password" name="customer[password_confirmation]" required></label>
      <button type="submit" class="btn btn--full">Reset password</button>
    {%- endform -%}
  </div>
</div>
