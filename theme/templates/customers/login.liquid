<div class="page-width page-width--narrow">
  <div class="section">
    <h1 class="h1">Log in</h1>
    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>Email</span><input type="email" name="customer[email]" required></label>
      <label class="field"><span>Password</span><input type="password" name="customer[password]"></label>
      <button type="submit" class="btn btn--full">Log in</button>
      <p class="small muted" style="margin-top:12px;"><a class="link" href="{{ routes.account_register_url }}">Create an account</a></p>
    {%- endform -%}
  </div>
</div>
