{%- liquid
  assign phone = settings.phone
  assign phone_href = phone | remove: '-' | remove: ' '
-%}

<p class="eyebrow" style="color:var(--green);">Auto Recycling &middot; Amite, Louisiana</p>
<h1 class="h1" style="color:#fff;">The new parts store is being built.</h1>
<p class="lede" style="color:var(--chrome);margin:0 auto;">
  Twenty-five thousand used OEM parts from our ten-acre lot are being loaded onto this site right now.
  Until it opens, call the yard or shop our eBay store — same parts, same 90-day warranty.
</p>

<div class="cluster" style="justify-content:center;margin-top:24px;">
  {%- if phone != blank -%}
    <a href="tel:{{ phone_href }}" class="btn btn--lg">{% render 'icon', name: 'phone' %} {{ phone }}</a>
  {%- endif -%}
  {%- if settings.ebay_url != blank -%}
    <a href="{{ settings.ebay_url }}" class="btn btn--lg btn--ghost-light" target="_blank" rel="noopener">
      Shop our eBay store
    </a>
  {%- endif -%}
</div>

<div class="pw__panel">
  <h2 class="h4" style="color:#fff;">Get told when we open</h2>
  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="form-success" style="margin:10px 0 0;">You're on the list. We'll email you the day it goes live.</p>
    {%- else -%}
      <div class="newsletter-form" style="margin-top:12px;">
        <label class="visually-hidden" for="pwEmail">Email</label>
        <input id="pwEmail" type="email" name="contact[email]" placeholder="you@email.com" required>
        <button type="submit" class="btn">Notify me</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <div class="footer__contact" style="margin-top:20px;text-align:left;">
    {%- if settings.address != blank -%}
      <div>{% render 'icon', name: 'pin' %}<span><b style="color:#fff;">The lot</b>{{ settings.address | newline_to_br }}</span></div>
    {%- endif -%}
    {%- if settings.hours != blank -%}
      <div>{% render 'icon', name: 'clock' %}<span><b style="color:#fff;">Hours</b>{{ settings.hours }}</span></div>
    {%- endif -%}
  </div>
</div>

<details style="margin-top:22px;">
  <summary class="small muted" style="cursor:pointer;">Store owner? Enter the password</summary>
  <div style="max-width:340px;margin:14px auto 0;">
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="pwPassword">Password</label>
      <input id="pwPassword" type="password" name="password" placeholder="Password"
             style="width:100%;padding:12px 14px;border-radius:var(--radius);border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.06);color:#fff;">
      <button type="submit" class="btn btn--full" style="margin-top:8px;">Enter</button>
    {%- endform -%}
  </div>
</details>
