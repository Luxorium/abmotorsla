<div class="page-width">
  <div class="section">
    <h1 class="h1">{{ blog.title }}</h1>
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="card">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="card__media">
              {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}
            </a>
          {%- endif -%}
          <div class="card__body">
            <span class="card__type">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="small muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>
