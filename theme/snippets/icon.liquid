{%- comment -%}
  Inline icon set. Usage: {% render 'icon', name: 'search' %}
  Stroke icons at 24x24 so they inherit currentColor and scale cleanly.
{%- endcomment -%}
{%- liquid
  assign s = 'stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"'
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" {{ s }}/><path d="m20 20-3.6-3.6" {{ s }}/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h2.2l2 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.55L20.5 8H6" {{ s }}/><circle cx="10" cy="20" r="1.4" fill="currentColor"/><circle cx="17.5" cy="20" r="1.4" fill="currentColor"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" {{ s }}/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" {{ s }}/></svg>
  {%- when 'phone' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 3h3l1.5 4-2 1.4a12 12 0 0 0 5.6 5.6L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3Z" {{ s }}/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" {{ s }}/><circle cx="12" cy="10" r="2.6" {{ s }}/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" {{ s }}/><path d="M12 7v5.2l3.2 2" {{ s }}/></svg>
  {%- when 'mail' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" {{ s }}/><path d="m3.5 6.5 8.5 6 8.5-6" {{ s }}/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5.5c0 4.4-2.9 8.2-7 9.5-4.1-1.3-7-5.1-7-9.5V6l7-3Z" {{ s }}/><path d="m9 12 2.2 2.2L15.5 10" {{ s }}/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h11v10H3zM14 9h3.6l2.4 3v4h-6" {{ s }}/><circle cx="7" cy="18" r="1.8" {{ s }}/><circle cx="17" cy="18" r="1.8" {{ s }}/></svg>
  {%- when 'recycle' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.6 5.5 12 4l1.9 3.3M18.3 9.6 20 13l-3.5 1M7.4 14.4 4 13l2.4-2.9" {{ s }}/><path d="M12 4 8.3 10.3M20 13l-3.7 6.4H12M4 13l3.7 6.4h4.6" {{ s }}/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7" {{ s }}/></svg>
  {%- when 'tag' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 11V4h7l9 9-7 7-9-9Z" {{ s }}/><circle cx="8" cy="8" r="1.3" fill="currentColor"/></svg>
  {%- when 'car' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 16v-3.2l1.8-4.6A2 2 0 0 1 7.7 7h8.6a2 2 0 0 1 1.9 1.2L20 12.8V16" {{ s }}/><path d="M3 16h18v2.2a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1-.8-.8V16M6 19v-3" {{ s }}/><path d="M5.5 12.6h13" {{ s }}/></svg>
  {%- when 'engine' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 14v-3h2.5l2-2H12V7h4v2h1.6l1.4 2H21v5h-2v3H9v-2H6.5L4 14Z" {{ s }}/></svg>
  {%- when 'wheel' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" {{ s }}/><circle cx="12" cy="12" r="3" {{ s }}/><path d="M12 3.5v5M12 15v5.5M3.5 12h5M15 12h5.5" {{ s }}/></svg>
  {%- when 'door' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 20V6.5L15 3v17" {{ s }}/><path d="M15 20h4V9.5L15 6.2" {{ s }}/><circle cx="12.5" cy="12" r="1" fill="currentColor"/></svg>
  {%- when 'bolt' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 3 5 13.5h5.5L11 21l8-10.5h-5.5L13 3Z" {{ s }}/></svg>
  {%- when 'dollar' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v18M16 7.2c-.8-1.4-2.3-2.2-4-2.2-2.2 0-3.8 1.2-3.8 3s1.4 2.6 4 3.2c2.8.6 4.2 1.6 4.2 3.4 0 2-1.8 3.4-4.4 3.4-2 0-3.7-.8-4.6-2.3" {{ s }}/></svg>
  {%- when 'photo' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" {{ s }}/><circle cx="8.5" cy="10" r="1.6" {{ s }}/><path d="m4 17 5-4.5 4 3.2 3-2.4 4 3.4" {{ s }}/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 4 2.5 5.1 5.5.8-4 3.9 1 5.5-5-2.6-5 2.6 1-5.5-4-3.9 5.5-.8L12 4Z" fill="currentColor" stroke="none"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13.5 6.5 20 12l-6.5 5.5" {{ s }}/></svg>
{%- endcase -%}
