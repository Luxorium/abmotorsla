{%- comment -%}
  Hands the shipping contract to JavaScript.

  The cart drawer is built client-side from /cart.js, which does not return product tags —
  it returns the hidden `_ship` line property the product form set. So the drawer needs the
  group→wording map too, and it used to carry its own copy of the rates in theme.js. That
  was a third place a rate could be changed in, and the only one a Liquid grep would miss.

  Rendered once in the layout as `window.ABM_SHIP`. theme.js falls back to its own defaults
  if this is ever absent, so the drawer degrades rather than breaking.

  Group ids match snippets/shipping-class.liquid. Rates match content/freight.json, which
  scripts/check_contracts.py enforces.

  'freight.rates' is also the list of groups that are actually freight. The drawer's
  commercial-address warning tests membership of it rather than "has a rate", because a
  paid parcel group has a rate too and must not raise that warning.

  'alerts' is the cart-level delivery warning the drawer shows above the line items. It is
  the same markup snippets/cart-delivery-notice.liquid renders on the /cart page — carried
  here as a string because /cart.js gives theme.js no way to call a snippet. Wording lives
  in that snippet; this only forwards it.
{%- endcomment -%}
{%- capture alert_mixed -%}{%- render 'cart-delivery-notice', kind: 'mixed' -%}{%- endcapture -%}
{%- capture alert_pickup -%}{%- render 'cart-delivery-notice', kind: 'pickup' -%}{%- endcapture -%}
{%- capture alert_freight -%}{%- render 'cart-delivery-notice', kind: 'freight' -%}{%- endcapture -%}
<script>
  window.ABM_SHIP = {
    "freight": { "rates": { "freight299": "$299.99", "freight199": "$199.99" } },
    "labels": {
      "pickup": "Pickup only",
      "freight299": "$299.99 freight",
      "freight199": "$199.99 freight",
      "ground49": "$49.99 shipping",
      "ground44": "$44.99 shipping",
      "ground34": "$34.99 shipping",
      "ground29": "$29.99 shipping",
      "ground24": "$24.99 shipping",
      "ground19": "$19.99 shipping",
      "ground14": "$14.99 shipping",
      "ground9": "$9.99 shipping",
      "free": "Free shipping"
    },
    "alerts": {
      "mixed": {{ alert_mixed | strip | json }},
      "pickup": {{ alert_pickup | strip | json }},
      "freight": {{ alert_freight | strip | json }}
    }
  };
</script>
