{%- comment -%}
  Renders the shipping notice for a part, in one of four shapes.

  Accepts:
    product (required)
    style: 'badge' | 'banner' | 'line' | 'assure'   (default 'badge')

  This file owns the customer-facing wording and the rates. 'shipping-class' owns the
  tag→group mapping. Together they are the only two places in the theme that encode the
  shipping contract in content/freight.json, and scripts/check_contracts.py fails the build
  if the rates or tags here drift from it.

  'banner' is the important one. A shopper in another state must learn a door is pickup-only
  on the product page, not by hitting a checkout with no available shipping method.
{%- endcomment -%}
{%- capture ship_group -%}{%- render 'shipping-class', product: product -%}{%- endcapture -%}
{%- liquid
  assign style = style | default: 'badge'
  assign phone = settings.phone
  assign phone_href = phone | remove: '-' | remove: ' '

  comment
    The rates. Changing one means changing content/freight.json and re-running
    scripts/setup_shipping.py --apply, or checkout and the page disagree.
  endcomment
  assign rate = ''
  if ship_group == 'freight299'
    assign rate = '$299.99'
  elsif ship_group == 'freight199'
    assign rate = '$199.99'
  endif
  assign is_freight = false
  if rate != ''
    assign is_freight = true
  endif
-%}

{%- case style -%}

  {%- when 'badge' -%}
    {%- if ship_group == 'pickup' -%}
      <span class="badge badge--pickup">Pickup only</span>
    {%- elsif is_freight -%}
      <span class="badge badge--freight">Freight {{ rate }}</span>
    {%- else -%}
      <span class="badge badge--green">Free shipping</span>
    {%- endif -%}

  {%- when 'line' -%}
    {%- if ship_group == 'pickup' -%}
      <span class="ship-line ship-line--pickup">{% render 'icon', name: 'pin' %} Pickup only &mdash; not shipped</span>
    {%- elsif is_freight -%}
      <span class="ship-line ship-line--freight">{% render 'icon', name: 'truck' %} {{ rate }} freight &middot; commercial address</span>
    {%- else -%}
      <span class="ship-line ship-line--free">{% render 'icon', name: 'truck' %} Free shipping</span>
    {%- endif -%}

  {%- when 'assure' -%}
    {%- comment -%} The one-line promise in the buybox, matched to THIS part. {%- endcomment -%}
    {%- if ship_group == 'pickup' -%}
      <div>{% render 'icon', name: 'pin' %}<span><b>Pickup or local delivery only.</b> We don't ship body parts or glass.</span></div>
    {%- elsif is_freight -%}
      <div>{% render 'icon', name: 'truck' %}<span><b>{{ rate }} flat rate freight</b> to a commercial address, or free pickup at the yard.</span></div>
    {%- else -%}
      <div>{% render 'icon', name: 'truck' %}<span><b>Free shipping</b> in the lower 48. Free local delivery around Amite.</span></div>
    {%- endif -%}

  {%- when 'banner' -%}
    {%- if ship_group == 'pickup' -%}
      <div class="ship-notice ship-notice--pickup">
        {% render 'icon', name: 'pin' %}
        <div>
          <b>Local pickup only &mdash; available in Amite, Louisiana</b>
          <p>
            We don't ship body panels or glass at any price. They arrive damaged too often, and
            crating them properly costs more than the panel is worth. This part is available for
            <b>pickup at the yard</b> or <b>free local delivery</b> in our area.
          </p>
          <p class="ship-notice__actions">
            {%- if phone != blank -%}
              <a href="tel:{{ phone_href }}" class="btn btn--sm">{% render 'icon', name: 'phone' %} Call {{ phone }}</a>
            {%- endif -%}
            <a href="{{ routes.root_url }}pages/freight" class="link">How pickup works &rarr;</a>
          </p>
        </div>
      </div>

    {%- elsif is_freight -%}
      <div class="ship-notice ship-notice--freight">
        {% render 'icon', name: 'truck' %}
        <div>
          <b>Ships freight &mdash; {{ rate }} flat rate</b>
          <p>
            <b>MUST SHIP TO A COMMERCIAL/BUSINESS ADDRESS WITH A FORKLIFT.</b>
            A freight truck can't unload a part this heavy at a house. Ship it to your mechanic's
            shop, or pick it up at the freight terminal nearest you &mdash; usually the cheapest option.
          </p>
          <p>
            Free pickup at our yard in Amite is always available. Not sure what works?
            {%- if phone != blank %} Call <a href="tel:{{ phone_href }}">{{ phone }}</a> and we'll sort it out before you pay.{% endif %}
          </p>
          <p class="ship-notice__actions">
            <a href="{{ routes.root_url }}pages/freight" class="link">Read the freight rules &rarr;</a>
          </p>
        </div>
      </div>

    {%- else -%}
      <div class="ship-notice ship-notice--free">
        {% render 'icon', name: 'truck' %}
        <div>
          <b>Free shipping</b>
          <p>Ships free anywhere in the lower 48, usually the same or next business day. Free local delivery around Amite, or pick it up at the yard.</p>
        </div>
      </div>
    {%- endif -%}

{%- endcase -%}
