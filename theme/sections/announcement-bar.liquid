<div class="announcement">
  <div class="announcement__inner">
    {%- if section.settings.message != blank -%}
      <span>{{ section.settings.message }}</span>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <span class="announcement__sep desktop-only">|</span>
      <a href="{{ section.settings.link_url }}" class="desktop-only">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "Free shipping on most parts · Free local delivery around Amite" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "90-day money-back warranty" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
