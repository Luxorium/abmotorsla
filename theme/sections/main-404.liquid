<div class="page-width">
  <div class="section center" style="padding:80px 0;">
    <p class="eyebrow">404 &mdash; part not found</p>
    <h1 class="h1">That page isn't on the lot.</h1>
    <p class="lede" style="margin:0 auto 24px;">
      It may have sold. Search for the part you need, or call the yard and we'll find it for you.
    </p>
    <div style="max-width:560px;margin:0 auto 20px;">
      {% render 'search-field', hero: true, uid: 'notfound', button_label: 'Search' %}
    </div>
    <div class="cluster" style="justify-content:center;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Browse all parts</a>
      {%- assign phone_href = settings.phone | remove: '-' -%}
      <a href="tel:{{ phone_href }}" class="btn btn--outline">{{ settings.phone }}</a>
    </div>
  </div>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
