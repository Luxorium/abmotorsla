<section class="section {{ section.settings.background }}">
  <div class="page-width">
    <div class="section-head section-head--row">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="muted" style="margin:0;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="link">
          View all{% if section.settings.collection.products_count > 0 %} {{ section.settings.collection.products_count }}{% endif %} &rarr;
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      The source collection is newest-first, and the yard photographs a whole car
      in one sitting — so the raw first eight was six Chrysler 300s, three of them
      the same $99.99 wheel. Scan deeper and spread the picks: one part per type,
      at most two per vehicle. 50 is Liquid's ceiling for iterating a collection
      without pagination, which is ample to fill eight tiles.
    {%- endcomment -%}
    {%- assign products = section.settings.collection.products -%}
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if products.size > 0 -%}
        {%- assign shown = 0 -%}
        {%- assign seen_types = '|' -%}
        {%- assign used_ids = '|' -%}
        {%- assign vehicle_once = '|' -%}
        {%- assign vehicle_twice = '|' -%}
        {%- for product in products limit: 50 -%}
          {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
          {%- liquid
            assign type_key = '|' | append: product.type | append: '|'

            assign vehicle = ''
            for t in product.tags
              assign head = t | slice: 0, 4
              assign year = head | plus: 0
              if year > 1900 and year < 2100
                assign vehicle = t | remove_first: head | strip
                break
              endif
            endfor
            assign vehicle_key = '|' | append: vehicle | append: '|'

            assign take = true
            if product.type != blank and seen_types contains type_key
              assign take = false
            endif
            if vehicle != blank and vehicle_twice contains vehicle_key
              assign take = false
            endif
          -%}
          {%- if take -%}
            {% render 'card-product', card_product: product %}
            {%- liquid
              assign shown = shown | plus: 1
              assign used_ids = used_ids | append: product.id | append: '|'
              assign seen_types = seen_types | append: product.type | append: '|'
              if vehicle != blank
                if vehicle_once contains vehicle_key
                  assign vehicle_twice = vehicle_twice | append: vehicle | append: '|'
                else
                  assign vehicle_once = vehicle_once | append: vehicle | append: '|'
                endif
              endif
            -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          The spread pass can come up short when the newest 50 are all one or two
          cars. Top the grid back up with whatever is left, newest first, so the
          row never renders with a hole in it.
        {%- endcomment -%}
        {%- if shown < section.settings.count -%}
          {%- for product in products limit: 50 -%}
            {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
            {%- assign id_key = '|' | append: product.id | append: '|' -%}
            {%- unless used_ids contains id_key -%}
              {% render 'card-product', card_product: product %}
              {%- liquid
                assign shown = shown | plus: 1
                assign used_ids = used_ids | append: product.id | append: '|'
              -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..section.settings.count) -%}
          {% render 'card-product' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured parts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just pulled" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New off the lot this week — every one photographed on our own racks." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Parts to show", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "", "label": "White" },
        { "value": "section--paper", "label": "Light grey" }
      ],
      "default": ""
    }
  ],
  "presets": [{ "name": "Featured parts" }]
}
{% endschema %}
