{%- liquid
  assign phone = settings.phone
  assign phone_href = phone | remove: '-' | remove: ' '
-%}

<div class="page-width">
  <div class="section">
    <div class="split" style="align-items:start;">
      <div>
        <h1 class="h1">{{ section.settings.heading }}</h1>
        <div class="rte lede">{{ section.settings.text }}</div>

        <div class="footer__contact" style="color:var(--ink);margin-top:26px;gap:16px;">
          {%- if phone != blank -%}
            <div>{% render 'icon', name: 'phone' %}<span><b>Call the yard</b><a class="link" href="tel:{{ phone_href }}">{{ phone }}</a></span></div>
          {%- endif -%}
          {%- if settings.email != blank -%}
            <div>{% render 'icon', name: 'mail' %}<span><b>Email</b><a class="link" href="mailto:{{ settings.email }}">{{ settings.email }}</a></span></div>
          {%- endif -%}
          {%- if settings.address != blank -%}
            <div>{% render 'icon', name: 'pin' %}<span><b>Come by the lot</b>{{ settings.address | newline_to_br }}</span></div>
          {%- endif -%}
          {%- if settings.hours != blank -%}
            <div>{% render 'icon', name: 'clock' %}<span><b>Hours</b>{{ settings.hours | newline_to_br }}</span></div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_map and settings.map_query != blank -%}
          <iframe
            title="Map to A&B Motors"
            width="100%" height="300" style="border:0;border-radius:10px;margin-top:22px;"
            loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            src="https://maps.google.com/maps?q={{ settings.map_query }}&output=embed"></iframe>
        {%- endif -%}
      </div>

      <div>
        {%- comment -%}
          Shopify names every contact form "contact_form", and the footer's parts-alert
          signup is one too, so the contact page carried the id twice — an invalid
          document, and "/contact#contact_form" could land on either. Naming it makes the
          id unique and the fragment land where the heading says it will.
        {%- endcomment -%}
        {%- form 'contact', class: 'contact-form', id: 'ContactPageForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Thanks — we got it. Someone from the yard will get back to you, usually same day.</p>
          {%- elsif form.errors -%}
            {%- comment -%}
              role="alert" so the failure is announced rather than silently rendered, and
              a real id so the offending field can point at it. Shopify's contact form
              exposes only the field names in form.errors, not per-field messages, so the
              association is name-level: the summary stays, but the email input is marked
              invalid and described by it instead of leaving the user to guess.
            {%- endcomment -%}
            <p class="form-error" id="ContactFormError" role="alert" tabindex="-1">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}

          <label class="field">
            <span>Name</span>
            <input type="text" name="contact[name]" required autocomplete="name">
          </label>

          <div class="split" style="gap:14px;grid-template-columns:1fr 1fr;">
            <label class="field">
              <span>Email</span>
              <input type="email" name="contact[email]" required autocomplete="email"
                     {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactFormError"{% endif %}>
            </label>
            <label class="field">
              <span>Phone</span>
              <input type="tel" name="contact[phone]" autocomplete="tel">
            </label>
          </div>

          <label class="field">
            <span>Year / make / model</span>
            <input type="text" name="contact[vehicle]" placeholder="2012 Chevrolet Silverado 1500">
          </label>

          {%- comment -%}
            Two jobs, one Shopify contact form. "Sell your car" used to link here and ask
            the seller which part they needed — the wrong question, with none of the four
            the yard actually has to know before it can quote: where the vehicle is, what
            it reads, whether the title is clean, and whether it moves under its own power.
          {%- endcomment -%}
          {%- if section.settings.form_mode == 'vehicle' -%}
            <div class="split" style="gap:14px;grid-template-columns:1fr 1fr;">
              <label class="field">
                <span>Where is it?</span>
                <input type="text" name="contact[location]" placeholder="Town or ZIP" autocomplete="postal-code">
              </label>
              <label class="field">
                <span>Mileage</span>
                <input type="text" name="contact[mileage]" inputmode="numeric" placeholder="Approximate is fine">
              </label>
            </div>

            <div class="split" style="gap:14px;grid-template-columns:1fr 1fr;">
              <label class="field">
                <span>Title</span>
                <select name="contact[title status]">
                  <option value="">Choose one</option>
                  <option>Clean title, in my name</option>
                  <option>Title in someone else's name</option>
                  <option>Salvage or rebuilt title</option>
                  <option>Lien not yet released</option>
                  <option>No title</option>
                  <option>Not sure</option>
                </select>
              </label>
              <label class="field">
                <span>Does it run?</span>
                <select name="contact[condition]">
                  <option value="">Choose one</option>
                  <option>Runs and drives</option>
                  <option>Runs, but does not drive</option>
                  <option>Does not run</option>
                  <option>Not sure</option>
                </select>
              </label>
            </div>

            <label class="field">
              <span>What's wrong with it</span>
              <textarea name="contact[body]" placeholder="Wrecked front end, blown engine, flood, or just sitting — and anything already missing off it."></textarea>
            </label>
          {%- else -%}
            <label class="field">
              <span>Part you need (or Part ID)</span>
              <input type="text" name="contact[part]" placeholder="Alternator — or Part ID 51250">
            </label>

            <label class="field">
              <span>Anything else</span>
              <textarea name="contact[body]" placeholder="VIN, trim, engine size — whatever helps us match it."></textarea>
            </label>
          {%- endif -%}

          <button type="submit" class="btn btn--lg btn--full">{{ section.settings.button_label }}</button>
          <p class="form-note" style="margin-top:10px;">
            We only use this to answer your request. No lists, no spam.
          </p>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what you're looking for" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Not everything on the lot is listed online yet. Send us the vehicle and the part, and we'll check the yard and the interchange for you.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send it to the yard" },
    {
      "type": "select",
      "id": "form_mode",
      "label": "What this form asks for",
      "options": [
        { "value": "parts", "label": "A part the customer needs" },
        { "value": "vehicle", "label": "A vehicle the customer is selling" }
      ],
      "default": "parts"
    },
    { "type": "checkbox", "id": "show_map", "label": "Show map", "default": true }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
