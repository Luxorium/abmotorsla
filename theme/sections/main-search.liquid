{%- paginate search.results by section.settings.per_page -%}
  <div class="page-width">
    <div class="section section--tight">
      <h1 class="h1">
        {%- if search.performed -%}
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
          {%- if search.terms != blank %} for &ldquo;{{ search.terms | escape }}&rdquo;{% endif -%}
        {%- else -%}
          Search the yard
        {%- endif -%}
      </h1>

      <div style="max-width:640px;margin:18px 0 6px;">
        {% render 'search-field', hero: true, uid: 'search', button_label: 'Search' %}
      </div>
      <p class="small muted">
        Search by <b>Part ID</b> (the number on every listing), vehicle stock number, interchange number, or year/make/model.
      </p>
    </div>

    {%- if search.performed -%}
      {%- comment -%}
        Shopify's search is an OR match across the whole catalogue, so a vehicle typed into
        it — "Subaru Legacy" — answers with 515 results whose tail is Infiniti, KIA and
        Audi parts, while the tag filter for that vehicle holds 102. The shopper cannot see
        which is which, and the wrong ones are the same category of part they came for.

        theme.js reads this against the same vehicles.json the pickers use. A query that is
        nothing but a vehicle we stock is answered with that vehicle's filter instead; a
        query that names a vehicle *and* something else ("2012 Silverado alternator") keeps
        its keyword results and gets a link to the filter above them, because the extra
        words are the part the shopper actually wants.
      {%- endcomment -%}
      {%- if search.terms != blank -%}
        <div data-vehicle-route
             data-src="{{ 'vehicles.json' | asset_url }}"
             data-base="{{ routes.all_products_collection_url }}"
             data-terms="{{ search.terms | escape }}"></div>
      {%- endif -%}

      {%- if search.results_count > 0 -%}
        <div class="toolbar">
          <span class="toolbar__count">Showing {{ search.results.size }} of {{ search.results_count }}</span>
          <div class="push">
            <label class="visually-hidden" for="SearchSort">Sort by</label>
            <select id="SearchSort" class="select" data-sort>
              {%- for option in search.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        <h2 class="visually-hidden">Search results</h2>
        <div class="grid grid--{{ section.settings.columns }}">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'card-product', card_product: item, eager: forloop.first %}
            {%- else -%}
              <article class="card">
                <div class="card__body">
                  <span class="card__type">{{ item.object_type }}</span>
                  <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p class="small muted">{{ item.content | strip_html | truncatewords: 22 }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <h2 class="h3">No parts matched &ldquo;{{ search.terms | escape }}&rdquo;</h2>
          <p class="muted" style="max-width:52ch;margin:0 auto 18px;">
            Our inventory changes every day, and not every part on the lot is listed yet.
            Call the yard and we'll walk the racks for you.
          </p>
          <div class="cluster" style="justify-content:center;">
            {%- assign phone_href = settings.phone | remove: '-' -%}
            <a href="tel:{{ phone_href }}" class="btn">{% render 'icon', name: 'phone' %} {{ settings.phone }}</a>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Browse all parts</a>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
