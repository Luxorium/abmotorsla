{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign qty = variant.inventory_quantity
  assign phone = settings.phone
  assign phone_href = phone | remove: '-' | remove: ' '
  assign warranty = settings.warranty_days | default: '90'
-%}
{%- comment -%}
  Resolved once and reused: the gallery note, the hidden cart property and the notices all
  need the same answer, and the tag chain that produces it lives in one snippet.
{%- endcomment -%}
{%- capture ship_group -%}{%- render 'shipping-class', product: product -%}{%- endcapture -%}
{%- comment -%}
  Some parts are listed with photographs of the donor vehicle they came off, not of the
  part itself. The gallery note below must not then claim the photos are "the actual part
  … what you see is what ships". 'photo-source' owns that test — the card, the search
  result and the Product structured data ask it too.
{%- endcomment -%}
{%- capture photo_source -%}{%- render 'photo-source', product: product -%}{%- endcapture -%}
{%- assign photos_are_donor = false -%}
{%- if photo_source == 'donor' -%}{%- assign photos_are_donor = true -%}{%- endif -%}

<div class="page-width">
  {% render 'product-crumb', format: 'html', product: product, collection: collection %}

  <div class="product">
    {%- comment -%} ---------------------------------------------- gallery {%- endcomment -%}
    <div data-gallery>
      <div class="gallery__main">
        {%- if product.featured_media -%}
          <img data-gallery-main
               src="{{ product.featured_media | image_url: width: 1400 }}"
               alt="{{ product.featured_media.alt | default: product.title | escape }}"
               width="1400" height="1050" fetchpriority="high">
        {%- else -%}
          <div class="card__placeholder">{% render 'icon', name: 'photo' %}</div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb"
                    data-gallery-thumb
                    data-full="{{ media | image_url: width: 1400 }}"
                    data-alt="{{ media.alt | default: product.title | escape }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="Photo {{ forloop.index }}">
              {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        The gallery falls back to a placeholder when a part has no photo, and this note
        would then promise a photo the shopper cannot see.
      {%- endcomment -%}
      {%- if product.featured_media -%}
      <p class="gallery__note">
        {%- if photos_are_donor -%}
          {% render 'icon', name: 'photo' %}
          {%- comment -%}
            Donor-photo listing: the pictures are of the car this part was removed from,
            not of the part. Say so here rather than let the shopper assume otherwise.
          {%- endcomment -%}
          <span>These photos are of the <b>donor vehicle</b> this part was removed from —
            not the part itself. This part was not photographed individually.</span>
        {%- else -%}
          {% render 'icon', name: 'check' %}
          {%- comment -%}
            Body panels and glass are never shipped, so promising "what ships" on one
            contradicts the pickup-only notice sitting directly below it.
          {%- endcomment -%}
          <span>These are photos of the actual part on our lot — not a stock image.
            {%- if ship_group == 'pickup' %} What you see is what you pick up.
            {%- else %} What you see is what ships.
            {%- endif %}</span>
        {%- endif -%}
      </p>
      {%- endif -%}
    </div>

    {%- comment -%} ------------------------------------------------ buybox {%- endcomment -%}
    <div>
      <div class="product__flags">
        {%- if product.type != blank -%}<span class="badge badge--dark">{{ product.type }}</span>{%- endif -%}
        {%- if product.tags contains 'Used OEM' -%}<span class="badge badge--green">Used OEM</span>{%- endif -%}
        {%- unless product.available -%}<span class="badge badge--sold">Sold</span>{%- endunless -%}
      </div>

      <h1 class="product__title">{{ product.title }}</h1>

      <div class="product__price-row">
        {% render 'price', product: product, large: true %}
      </div>

      <div class="product__stock">
        <span class="dot{% unless product.available %} dot--out{% endunless %}"></span>
        {%- if product.available -%}
          In stock &mdash; ready to ship or pick up
        {%- else -%}
          This one sold — call us, we may have another
        {%- endif -%}
      </div>

      {% render 'shipping-group', product: product, style: 'banner' %}

      <div class="buybox" data-buybox>
        {%- form 'product', product, data-product-form: true -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          {%- comment -%}
            Underscore-prefixed properties are hidden from the customer and the order,
            and they DO come back from /cart.js — which is how the cart drawer knows a
            line is pickup-only without a second round trip for tags.
          {%- endcomment -%}
          <input type="hidden" name="properties[_ship]" value="{{ ship_group }}">

          {%- if product.available -%}
            <div class="cluster" style="margin-bottom:12px;">
              <div class="qty" data-qty>
                <button type="button" data-qty-step="down" aria-label="Decrease quantity">&minus;</button>
                <input type="number" name="quantity" value="1" min="1"
                       max="{{ variant.inventory_quantity | at_least: 1 }}" aria-label="Quantity">
                <button type="button" data-qty-step="up" aria-label="Increase quantity">+</button>
              </div>
              {%- if qty > 1 -%}<span class="small muted">{{ qty }} available</span>{%- endif -%}
            </div>

            <button type="submit" class="btn btn--lg btn--full" data-add-button>Add to cart</button>
            {{ form | payment_button }}
          {%- else -%}
            <button type="button" class="btn btn--lg btn--full" disabled>Sold</button>
          {%- endif -%}

          <p class="form-error" data-cart-error hidden></p>
        {%- endform -%}

        {%- if phone != blank -%}
          <a href="tel:{{ phone_href }}" class="btn btn--outline btn--full">
            {% render 'icon', name: 'phone' %} Questions? Call {{ phone }}
          </a>
        {%- endif -%}

        <div class="buybox__assure">
          <div>{% render 'icon', name: 'shield' %}<span><b>{{ warranty }}-day money-back warranty.</b> If it doesn't work out, send it back.</span></div>
          {%- comment -%}
            Say the right thing for THIS part. A blanket "free shipping" line on a
            pickup-only door contradicts the banner directly above it.
          {%- endcomment -%}
          {% render 'shipping-group', product: product, style: 'assure' %}
        </div>
      </div>

      <div style="margin:16px 0;">{% render 'credibility' %}</div>

      {%- comment -%} --------------------------------------- part details {%- endcomment -%}
      <dl class="spec-table">
        {%- if variant.sku != blank -%}
          {%- comment -%}
            "Part ID", not "Stock number". The SKU is the yard's R#, while the
            description CoreYard writes calls a different number the stock number
            (R# 53347 vs Stock # 261702). Both are real; labelling this one
            "Stock number" put two different numbers under the same name on the
            same page, so a customer could quote the wrong one on the phone.
          {%- endcomment -%}
          <div><dt>Part ID</dt><dd>{{ variant.sku }}</dd></div>
        {%- endif -%}
        {%- if product.type != blank -%}
          <div><dt>Part type</dt><dd>{{ product.type }}</dd></div>
        {%- endif -%}
        {%- for field in product.metafields.abm -%}
          {%- assign key = field | first -%}
          {%- assign value = field | last -%}
          {%- comment -%}
            `grade` is excluded alongside `fitment`: CoreYard renders `condition` as
            "Grade A", so listing the bare letter too gives the table two rows saying
            the same thing.
          {%- endcomment -%}
          {%- unless value == blank or key == 'fitment' or key == 'grade' -%}
            {%- comment -%}
              Mileage is a bare integer in the metafield, and the description CoreYard
              renders below spells the same number "224,515 mi". Printing the raw value
              here put both forms of one number on one page. Separators and the unit are
              display, so they belong to whatever is displaying it.
            {%- endcomment -%}
            {%- comment -%}
              The grade is a letter with no scale printed anywhere the shopper can reach,
              and a part with no grade says "Used, inspected", which reads as a different
              kind of claim rather than the same claim with less detail. Link the rubric
              from the row that raises the question.
            {%- endcomment -%}
            {%- if key == 'condition' -%}
              <div><dt>Condition</dt><dd>{{ value }} &middot;
                <a class="link" href="{{ routes.root_url }}pages/warranty-returns#grades">What do the grades mean?</a>
              </dd></div>
            {%- elsif key == 'mileage' -%}
              <div><dt>Mileage</dt><dd>{%- render 'count-with-delimiters', count: value -%}&nbsp;mi</dd></div>
            {%- else -%}
              <div><dt>{{ key | replace: '_', ' ' | capitalize }}</dt><dd>{{ value }}</dd></div>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        <div><dt>Warranty</dt><dd>{{ warranty }}-day money back</dd></div>
      </dl>

      {%- comment -%}
        Links to the vehicle collections this part belongs to. A shopper who has found the
        wrong alternator for their Ranger is one click from every other Ranger part, which
        is the question they actually came with.

        It is also how those 92 collections get internal links: nothing else on the site
        points at them except the /collections index, and a page reachable only from one
        index is a page search engines treat as an afterthought.

        Categories are excluded by name so this lists vehicles only — same shared list the
        breadcrumb uses.
      {%- endcomment -%}
      {%- capture category_handles -%}{%- render 'category-handles' -%}{%- endcapture -%}
      {%- assign categories = category_handles | strip | split: ',' -%}
      {%- assign internal = 'all,just-pulled,home-page-picks' | split: ',' -%}
      {%- assign vehicle_links = '' -%}
      {%- for c in product.collections -%}
        {%- unless categories contains c.handle or internal contains c.handle -%}
          {%- capture vehicle_links -%}{{ vehicle_links }}<a class="link" href="{{ c.url }}">{{ c.title }}</a>~{%- endcapture -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign vehicle_list = vehicle_links | split: '~' -%}
      {%- comment -%}
        These are the make and model collections this part belongs to — every Subaru
        Legacy part we stock, from any donor car. It read "More from this vehicle", which
        a shopper takes to mean the rest of the car their part came off, and the parts it
        actually lists come off dozens of different cars.

        The donor's own stock number would be the honest link, but CoreYard writes it into
        the description body and publishes no tag or metafield for it, so there is nothing
        the storefront can filter on. Until there is, the label says what the links do.
      {%- endcomment -%}
      {%- if vehicle_list.size > 0 -%}
        <p class="small muted" style="margin-top:14px;">
          Browse more parts:
          {%- for link in vehicle_list -%}
            {{ link }}{%- unless forloop.last %} &middot; {% endunless -%}
          {%- endfor -%}
        </p>
      {%- endif -%}

      {%- if section.settings.show_share -%}
        <p class="small muted" style="margin-top:14px;">
          Part ID {{ variant.sku }} &middot; Ask about this part: <a class="link" href="mailto:{{ settings.email }}?subject=Part%20{{ variant.sku | url_encode }}">{{ settings.email }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------------------------------------------- fitment {%- endcomment -%}
  {%- assign fitment = product.metafields.abm.fitment.value -%}
  {%- if fitment != blank -%}
    <div class="section section--tight">
      <div class="fitment">
        <div class="fitment__head">
          {% render 'icon', name: 'car' %}
          <span>Fits these vehicles</span>
        </div>
        <table>
          <thead><tr><th>Years</th><th>Make</th><th>Model</th><th>Notes</th></tr></thead>
          <tbody>
            {%- for row in fitment limit: 25 -%}
              <tr>
                <td class="nowrap">{{ row.years }}</td>
                <td>{{ row.make }}</td>
                <td>{{ row.model }}</td>
                <td class="muted">{{ row.note }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        {%- if fitment.size > 25 -%}
          <p class="fitment__more">…and {{ fitment.size | minus: 25 }} more applications. Not sure it fits yours? Call {{ phone }}.</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} --------------------------------------------- accordions {%- endcomment -%}
  <div class="section section--tight" style="max-width:900px;">
    <div class="accordion">
      {%- if product.description != blank -%}
        <details class="accordion__item" open>
          <summary class="accordion__summary">Part details &amp; fitment</summary>
          <div class="accordion__body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'policy' -%}
          <details class="accordion__item" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">{{ block.settings.heading }}</summary>
            <div class="accordion__body rte">{{ block.settings.content }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} ------------------------------------------ related parts {%- endcomment -%}
{%- comment -%}
  This used to look up collections[product.type | handle] and fall back to
  collections.all.products. There are 224 product types and 11 collections, so the
  lookup missed on nearly every part and the fallback served the head of the whole
  catalogue — a Chrysler climate control page recommending Volvo starter motors
  under the heading "More Temperature / Climate Control from the yard".

  Server-side we can only iterate a collection, never filter it by tag, so the
  honest baseline is the category collection the part genuinely belongs to (the
  smart collections are keyed on TYPE, so membership is always correct). The
  JavaScript then upgrades that to parts that fit the same vehicle, pulled from
  the tag-filtered ?view=cards URL. If the fetch fails the baseline stands.
{%- endcomment -%}
{%- if section.settings.show_related -%}
  {%- liquid
    assign rel = nil
    for c in product.collections
      unless c.handle == 'just-pulled' or c.handle == 'home-page-picks' or c.handle == 'frontpage'
        assign rel = c
        break
      endunless
    endfor

    comment
      Which vehicle to offer more parts for. It comes from the structured fitment
      metafield: each row carries a `label` that is exactly the vehicle tag CoreYard
      also writes ("Chrysler 300"), so the collection URL below filters on a real tag
      without anyone having to take a title apart to find it.

      The fallback reads the tags the old way, and exists only for a product published
      before CoreYard started writing the metafield. Once a full sync has run it never
      fires; it is cheap enough to leave as a safety net during the migration.
    endcomment
    assign vehicle = ''
    assign fitment_rows = product.metafields.abm.fitment.value
    if fitment_rows != blank
      for row in fitment_rows
        if row.label != blank
          assign vehicle = row.label
          break
        endif
      endfor
    endif
    if vehicle == blank
      for t in product.tags
        assign head = t | slice: 0, 4
        assign year = head | plus: 0
        if year > 1900 and year < 2100
          assign vehicle = t | remove_first: head | strip
          break
        endif
      endfor
    endif
  -%}

  {%- if rel != nil or vehicle != blank -%}
    <div class="section section--paper"
         data-related
         data-related-exclude="{{ product.id }}"
         {%- comment -%}
           The tag behind this link is the model, not the shopper's exact vehicle: on a
           2010-2019 Legacy listing it returns 2000-2004 Legacy parts too, which fit the
           model name and not necessarily the car. Naming the section "parts that fit"
           was the overstatement — the shopper reads it as vetted fitment and it is a
           model-level browse. The tag would have to carry the year to promise more than
           that, and a year-exact tag on a rare vehicle can return nothing at all, so the
           heading is what changed rather than the query.
         {%- endcomment -%}
         {%- if vehicle != blank %}
           data-related-url="{{ routes.all_products_collection_url }}/{{ vehicle | handleize }}?view=cards"
           data-related-heading="Other {{ vehicle | escape }} parts &mdash; check the year and options on each"
         {%- endif %}>
      <div class="page-width">
        <div class="section-head">
          <h2 class="h2" data-related-title>
            More {{ rel.title | default: 'parts' }} from the yard
          </h2>
        </div>
        <div class="grid grid--4" data-related-grid>
          {%- assign shown = 0 -%}
          {%- for item in rel.products limit: 12 -%}
            {%- if item.id != product.id and shown < 4 -%}
              {% render 'card-product', card_product: item %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<div class="sticky-buy" data-sticky-buy>
  {% render 'price', product: product %}
  {%- if product.available -%}
    <form method="post" action="{{ routes.cart_add_url }}" class="push" style="flex:1;display:flex;justify-content:flex-end;">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="btn">Add to cart</button>
    </form>
  {%- else -%}
    <a href="tel:{{ phone_href }}" class="btn push">Call about this part</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related parts", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show stock number / email line", "default": true }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Every listing shows what shipping costs before you buy. Most parts go UPS Ground at a flat rate; engines, transmissions and axles go LTL freight to a commercial address; body panels and glass are pickup or local delivery only.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "policy",
        "settings": {
          "heading": "Shipping",
          "content": "<p>Every listing shows what shipping costs before you buy — a flat UPS Ground rate for most parts, LTL freight for engines, transmissions and axles, and pickup or free local delivery for body panels and glass. Orders leave the yard within 1&ndash;2 business days, usually the next one.</p>"
        }
      },
      {
        "type": "policy",
        "settings": {
          "heading": "90-day warranty & returns",
          "content": "<p>Every part carries a 90-day money-back warranty. If it doesn't fit or doesn't work, call the yard at 985-748-7195 and we'll make it right — refund or replacement, your call.</p>"
        }
      },
      {
        "type": "policy",
        "settings": {
          "heading": "Will it fit my vehicle?",
          "content": "<p>The listing shows the vehicles this part interchanges with. If yours isn't listed, or you're not sure, call us with your VIN and we'll check it against our interchange system before you buy.</p>"
        }
      }
    ]
  }
}
{% endschema %}
