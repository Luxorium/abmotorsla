{%- liquid
  # `collections.all.products_count` is a denormalised counter Shopify updates lazily: it
  # read 25,001 against a store holding 26,735 published products. The metafield is written
  # every minute by `coreyard counts` from the yard's own listable set, which reconcile
  # keeps equal to what is published, so it is both fresher and exact. Liquid's own count
  # stays as the fallback for a store that does not run that job.
  assign source_count = shop.metafields.abm.source_inventory_count.value
  assign listed_count = shop.metafields.abm.source_inventory_count.value
  if listed_count == blank
    assign listed_count = collections['all'].products_count
  endif
-%}
{%- capture source_count_text -%}
  {%- if source_count != blank -%}
    {%- render 'count-with-delimiters', count: source_count -%}
  {%- else -%}
    25,000+
  {%- endif -%}
{%- endcapture -%}
{%- capture listed_count_text -%}
  {%- if listed_count > 0 -%}
    {%- render 'count-with-delimiters', count: listed_count -%}
  {%- else -%}
    22,000+
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  assign source_count_text = source_count_text | strip
  assign listed_count_text = listed_count_text | strip
  assign live_subheading = section.settings.subheading
  assign live_subheading = live_subheading | replace: '{powerlink_count}', source_count_text
  assign live_subheading = live_subheading | replace: '{listed_count}', listed_count_text
-%}

<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag:
           widths: '800,1200,1800,2400',
           sizes: '100vw',
           loading: 'eager',
           fetchpriority: 'high',
           alt: '' }}
    </div>
  {%- endif -%}

  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="h0">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ live_subheading }}</p>
      {%- endif -%}

      <div class="hero__search">
        {% render 'search-field',
             hero: true,
             uid: 'hero',
             placeholder: section.settings.search_placeholder,
             button_label: section.settings.button_label %}
      </div>

      {%- if section.settings.examples != blank -%}
        <div class="hero__hints">
          <span>Try:</span>
          {%- assign examples = section.settings.examples | split: ',' -%}
          {%- for ex in examples -%}
            {%- assign term = ex | strip -%}
            <a href="{{ routes.search_url }}?q={{ term | url_encode }}">{{ term }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__stats">
          {%- for block in section.blocks -%}
            {%- liquid
              assign stat_value = block.settings.value
              if block.settings.count_source == 'powerlink'
                assign stat_value = source_count_text
              elsif block.settings.count_source == 'listed'
                assign stat_value = listed_count_text
              endif
            -%}
            <div class="hero__stat" {{ block.shopify_attributes }}>
              <b>{{ stat_value }}</b>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero + part search",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo", "info": "A wide shot of the yard or a parts rack works best. It sits behind a dark scrim." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Used OEM parts · Amite, Louisiana" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The part you need is already on our lot." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Search {listed_count} parts listed online and growing. Save up to 50% off new, backed by a 90-day money-back warranty."
    },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by Part ID, year, make, model, or interchange #" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find My Part" },
    { "type": "text", "id": "examples", "label": "Example searches (comma separated)", "default": "Engine, Transmission, Alternator, Tailgate, Wheel" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "count_source",
          "label": "Live count",
          "default": "manual",
          "options": [
            { "value": "manual", "label": "Manual value" },
            { "value": "powerlink", "label": "Yard inventory (not shown by default)" },
            { "value": "listed", "label": "Listed online" }
          ]
        },
        { "type": "text", "id": "value", "label": "Manual value", "default": "90 days" },
        { "type": "text", "id": "label", "label": "Label", "default": "Listed online" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero + part search",
      "blocks": [
        { "type": "stat", "settings": { "count_source": "listed", "value": "22,000+", "label": "Parts listed online" } },
        { "type": "stat", "settings": { "value": "Since 1958", "label": "Family run" } },
        { "type": "stat", "settings": { "value": "10 acres", "label": "Of inventory" } },
        { "type": "stat", "settings": { "value": "90 days", "label": "Money-back warranty" } }
      ]
    }
  ]
}
{% endschema %}
