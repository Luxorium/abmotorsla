<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag:
           widths: '800,1200,1800,2400',
           sizes: '100vw',
           loading: 'eager',
           fetchpriority: 'high',
           alt: '' }}
    </div>
  {%- endif -%}

  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="h0">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero__search">
        {% render 'search-field',
             hero: true,
             uid: 'hero',
             placeholder: section.settings.search_placeholder,
             button_label: section.settings.button_label %}
      </div>

      {%- if section.settings.examples != blank -%}
        <div class="hero__hints">
          <span>Try:</span>
          {%- assign examples = section.settings.examples | split: ',' -%}
          {%- for ex in examples -%}
            {%- assign term = ex | strip -%}
            <a href="{{ routes.search_url }}?q={{ term | url_encode }}">{{ term }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__stats">
          {%- for block in section.blocks -%}
            <div class="hero__stat" {{ block.shopify_attributes }}>
              <b>{{ block.settings.value }}</b>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero + part search",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo", "info": "A wide shot of the yard or a parts rack works best. It sits behind a dark scrim." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Used OEM parts · Amite, Louisiana" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The part you need is already on our lot." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Search 25,000+ inspected parts pulled from our 10-acre yard. Save up to 50% off new, backed by a 90-day money-back warranty."
    },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Try \"2012 Silverado alternator\" or a stock number" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find My Part" },
    { "type": "text", "id": "examples", "label": "Example searches (comma separated)", "default": "Engine, Transmission, Alternator, Tailgate, Wheel" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "25,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Parts in stock" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero + part search",
      "blocks": [
        { "type": "stat", "settings": { "value": "25,000+", "label": "Parts in stock" } },
        { "type": "stat", "settings": { "value": "Since 1958", "label": "Family run" } },
        { "type": "stat", "settings": { "value": "10 acres", "label": "Of inventory" } },
        { "type": "stat", "settings": { "value": "90 days", "label": "Money-back warranty" } }
      ]
    }
  ]
}
{% endschema %}
