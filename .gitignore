# Per-machine run state for the scripts. These are resume checkpoints holding
# thousands of product GIDs — useful locally, meaningless in version control.
.store_setup_state.json
.tag_shipping_state.json
# Left by scripts that have since moved into CoreYard; ignored so an existing checkout
# does not start reporting them as untracked after the move.
.charm_prices_state.json
.cleanup_state.json
.orders_state.json
.weights_state.json
.retitle_rollback.json
.retitle_state.json

# Built preview bundle (regenerate with preview/build.py)
preview/dist/

# Live theme files saved before scripts/deploy_theme.py overwrote them. Local undo
# history for a deploy, meaningless to anyone else.
.theme-backups/

# Never commit credentials. This repository reads .env here (or wherever ABM_ENV points);
# CoreYard keeps its own, separately.
.env
*.pem

# Python bytecode
__pycache__/
*.pyc

# Local agent/editor state — kept out of the repo so the rule travels with a clone
.claude/

# Internal working checklists. Planning notes, business decisions, and a running record of
# what is not done yet — written for one desk, not for a public repository, which this is.
CHECKLIST.txt
CLAUDE_CHECKLIST.txt
